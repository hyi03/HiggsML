{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4l_draft_v2_access.schema.json",
  "title": "Draft-v2 exploratory source/freeze/history access receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "decision", "dataset", "source_population", "source_kind",
    "historical_test_included", "independent", "protocol_sha256", "prepared_artifact_id", "freeze_id",
    "history_sha256", "reviewed_by", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "h4l-draft-v2-access-v1"},
    "status": {"enum": ["pending", "approved"]},
    "decision": {"enum": ["pending", "allow_exploratory_reuse"]},
    "dataset": {"const": "atlas2020_4lep"},
    "source_population": {"const": "all_mc"},
    "source_kind": {"enum": ["synthetic", "controlled_mc"]},
    "historical_test_included": {"const": true},
    "independent": {"const": false},
    "protocol_sha256": {"$ref": "#/$defs/digest"},
    "prepared_artifact_id": {"$ref": "#/$defs/digest"},
    "freeze_id": {"$ref": "#/$defs/digest"},
    "history_sha256": {"$ref": "#/$defs/digest"},
    "reviewed_by": {"type": "string"},
    "reviewed_at": {"type": "string"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
