{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4l-off-assessment-access-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_id",
    "evaluation_plan_id",
    "blocks",
    "source_review",
    "review_mode",
    "independent",
    "source_history",
    "access_id"
  ],
  "properties": {
    "schema_version": {
      "const": "h4l-off-assessment-access-v3"
    },
    "specification_id": {
      "$ref": "#/$defs/digest"
    },
    "evaluation_plan_id": {
      "$ref": "#/$defs/digest"
    },
    "blocks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "seed",
          "candidate_keys",
          "block_id",
          "pairing_contract_digest"
        ]
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "review_mode": {
      "type": "string",
      "minLength": 1
    },
    "independent": {
      "type": "boolean"
    },
    "source_history": {
      "type": "array"
    },
    "access_id": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
