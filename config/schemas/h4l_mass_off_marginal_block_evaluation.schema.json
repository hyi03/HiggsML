{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "cell_id",
    "claim_id",
    "binding",
    "execution_status",
    "scientific_status",
    "qualification",
    "joint_support",
    "planned_toys_per_candidate",
    "generated_physical_toys",
    "candidate_results",
    "terminal_id",
    "marginal_support",
    "coupling_receipts",
    "pairing_kind",
    "physical_event_pairing",
    "uncertainty_scope",
    "primary_claim_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "h4l-mass-off-marginal-block-evaluation-v1"
    },
    "cell_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "execution_status": {
      "const": "complete"
    },
    "scientific_status": {
      "enum": [
        "valid",
        "insufficient_statistics",
        "unsupported_assessment_support",
        "template_stat_model_unvalidated",
        "inference_incomplete"
      ]
    },
    "qualification": {
      "type": "object"
    },
    "joint_support": {
      "type": "object"
    },
    "planned_toys_per_candidate": {
      "type": "integer",
      "minimum": 0
    },
    "generated_physical_toys": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_results": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "candidate_id",
          "attempted_fits",
          "completed_fits",
          "valid_fits"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "attempted_fits": {
            "type": "integer",
            "minimum": 0
          },
          "completed_fits": {
            "type": "integer",
            "minimum": 0
          },
          "valid_fits": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "terminal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "marginal_support": {
      "type": "object"
    },
    "coupling_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract",
          "cells",
          "support_id",
          "role_map",
          "numeric_contract",
          "identity_qualification"
        ]
      }
    },
    "pairing_kind": {
      "const": "marginal_common_total_monotone_crn"
    },
    "physical_event_pairing": {
      "const": false
    },
    "uncertainty_scope": {
      "const": "conditional_on_registered_crn_coupling"
    },
    "primary_claim_eligible": {
      "const": false
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "freeze_artifact_id",
        "specification_id",
        "evaluation_plan_id",
        "pairing_contract",
        "stage",
        "mu",
        "training_seed",
        "candidate_ids",
        "access_receipt",
        "budget",
        "rng"
      ],
      "properties": {
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "freeze_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "specification_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "pairing_contract": {
          "const": "701f0e16ebce6c8425cff9f5da40b0583d4632d0601652e84f96f345ece95d1b"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "mu": {
          "type": [
            "number",
            "null"
          ]
        },
        "training_seed": {
          "type": "integer"
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "access_receipt": {
          "type": "object",
          "minProperties": 1
        },
        "budget": {
          "type": "object",
          "minProperties": 1
        },
        "rng": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scientific_status": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "coupling_receipts": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
