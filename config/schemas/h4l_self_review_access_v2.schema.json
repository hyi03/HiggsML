{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4l-off-self-review-access-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "review_mode", "independent", "reviewer", "prepared_artifact_id", "population_id", "protocol_sha256", "freeze_artifact_id", "history_review", "history_audit", "role_isolation", "allowed_conclusions", "p0_reference", "t1_reference"],
  "properties": {
    "schema_version": {"const": "h4l-off-self-review-access-v2"},
    "status": {"const": "validated_for_self_reviewed_exploratory_access"},
    "review_mode": {"const": "single_researcher_self_review"},
    "independent": {"const": false},
    "reviewer": {"type": "string", "minLength": 1},
    "prepared_artifact_id": {"$ref": "#/$defs/digest"},
    "population_id": {"$ref": "#/$defs/digest"},
    "protocol_sha256": {"$ref": "#/$defs/digest"},
    "freeze_artifact_id": {"$ref": "#/$defs/digest"},
    "history_review": {"const": "self_reviewed_no_access_in_declared_roots"},
    "history_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["roots", "registry", "matches", "scope"],
      "properties": {
        "roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "registry": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}}]},
        "matches": {"type": "array", "maxItems": 0},
        "scope": {"const": "declared_roots_only_not_independent_validation"}
      }
    },
    "role_isolation": {"const": "self_reviewed_physical_groups_disjoint"},
    "allowed_conclusions": {"const": "exploratory_self_reviewed_not_independently_validated"},
    "p0_reference": {"$ref": "#/$defs/receipt"},
    "t1_reference": {"$ref": "#/$defs/receipt"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}}
  }
}
