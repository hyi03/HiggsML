{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h4l-mass-off-freeze-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "protocol_sha256",
    "specification_id",
    "specification_path",
    "specification_artifact_id",
    "registration_artifact_id",
    "template_artifact_id",
    "prepared_artifact_id",
    "mass_edges",
    "assessment_access",
    "evidence_id"
  ],
  "properties": {
    "schema_version": {
      "const": "h4l-mass-off-freeze-v3"
    },
    "status": {
      "const": "frozen"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/digest"
    },
    "specification_id": {
      "$ref": "#/$defs/digest"
    },
    "specification_path": {
      "type": "string",
      "minLength": 1
    },
    "specification_artifact_id": {
      "$ref": "#/$defs/digest"
    },
    "registration_artifact_id": {
      "$ref": "#/$defs/digest"
    },
    "template_artifact_id": {
      "$ref": "#/$defs/digest"
    },
    "prepared_artifact_id": {
      "$ref": "#/$defs/digest"
    },
    "mass_edges": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "number"
      }
    },
    "assessment_access": {
      "const": "pending_independent_history_and_reference_review"
    },
    "evidence_id": {
      "$ref": "#/$defs/digest"
    },
    "threshold_method": {
      "const": "joint-support-v1"
    },
    "analysis_contract": {
      "type": "object"
    },
    "analysis_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_core_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "dependentRequired": {
    "threshold_method": [
      "threshold_method",
      "analysis_contract",
      "analysis_contract_digest",
      "source_core_protocol_digest"
    ],
    "analysis_contract": [
      "threshold_method",
      "analysis_contract",
      "analysis_contract_digest",
      "source_core_protocol_digest"
    ],
    "analysis_contract_digest": [
      "threshold_method",
      "analysis_contract",
      "analysis_contract_digest",
      "source_core_protocol_digest"
    ],
    "source_core_protocol_digest": [
      "threshold_method",
      "analysis_contract",
      "analysis_contract_digest",
      "source_core_protocol_digest"
    ]
  }
}
